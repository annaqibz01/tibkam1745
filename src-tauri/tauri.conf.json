{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tibkam1745",
  "version": "1.3.0",
  "identifier": "com.tibkam1745",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tibkam1745",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 600,
        "minHeight": 450,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/pocketbase.exe": "bin/pocketbase.exe",
      "bin/koleksi_awal.db": "bin/koleksi_awal.db",
      "bin/printer_service.exe": "bin/printer_service.exe",
      "../../backend/pb_migrations/*": "pb_migrations/",
      "../../backend/pb_hooks/*": "pb_hooks/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}